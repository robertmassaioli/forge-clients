# Always use the public npm registry.
# This prevents CI runners (e.g. Atlassian-hosted GitHub Actions runners) from
# inheriting a corporate .npmrc that points @forge/* packages at a private
# Atlassian registry (packages.atlassian.com), which is not accessible without
# internal credentials and causes ERR_PNPM_FETCH_404.
#
# Precedence: project .npmrc > user ~/.npmrc > global .npmrc
# So these settings take priority over any corporate ~/.npmrc on the developer's machine.
#
# NOTE: If pnpm-lock.yaml ends up containing packages.atlassian.com tarball URLs
# (which happens when pnpm reuses its local store cache from a previous install
# that used the Atlassian corporate registry), regenerate it with:
#
#   rm -rf node_modules packages/*/node_modules docs/node_modules pnpm-lock.yaml
#   pnpm install
#
# Deleting node_modules forces pnpm to re-resolve all tarball URLs from scratch
# using the registry settings in this file, producing a clean lockfile.
registry=https://registry.npmjs.org/

# Explicitly scope @forge/* and @atlassian/* to the public registry too,
# since scoped packages can be redirected independently by corporate configs.
@forge:registry=https://registry.npmjs.org/
@atlassian:registry=https://registry.npmjs.org/
@atlaskit:registry=https://registry.npmjs.org/
@atlassian-labs:registry=https://registry.npmjs.org/
