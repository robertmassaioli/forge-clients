{
  "name": "@forge-clients/generator",
  "version": "0.1.0",
  "description": "CLI and library for generating @forge-clients Jira and Confluence clients from Atlassian OpenAPI specs",
  "type": "module",
  "bin": {
    "forge-clients-gen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "generate": "node dist/cli.js generate",
    "update-specs": "node dist/cli.js update-specs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@forge-clients/specs": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fast-json-patch": "^3.1.1",
    "openapi-types": "^12.1.3",
    "ora": "^8.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
