{
  "name": "forge-clients-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @forge-clients — TypeScript REST API clients for Atlassian Forge Apps",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @forge-clients/core run build",
    "build:generator": "pnpm --filter @forge-clients/generator run build",
    "build:jira": "pnpm --filter @forge-clients/jira run build",
    "build:confluence": "pnpm --filter @forge-clients/confluence run build",
    "build:specs": "pnpm --filter @forge-clients/specs run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "generate": "pnpm --filter @forge-clients/generator run generate",
    "update-specs": "pnpm --filter @forge-clients/generator run update-specs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsup": "^8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
